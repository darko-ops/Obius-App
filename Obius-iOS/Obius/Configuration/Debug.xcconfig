// Debug Configuration
// Obius iOS App

// Import local secrets (gitignored)
#include? "Secrets.xcconfig"

// Build Settings
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
SWIFT_OPTIMIZATION_LEVEL = -Onone
ENABLE_TESTABILITY = YES
ONLY_ACTIVE_ARCH = YES
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG

// Environment
OBIUS_API_BASE_URL = https://dev.obius.io
SUPABASE_URL = https://sqixnykiayfyzrrcjips.supabase.co
SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNxaXhueWtpYXlmeXpycmNqaXBzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Njk1NzA5NDEsImV4cCI6MjA4NTE0Njk0MX0.h3XIwWspXoTYf7SOgGamLngc11itXwO-xYqLd2rOopA
CLAUDE_API_KEY = $(CLAUDE_API_KEY)
REVENUECAT_API_KEY = $(REVENUECAT_API_KEY_DEBUG)


// Bundle ID (append .debug for debug builds)
PRODUCT_BUNDLE_IDENTIFIER = app.obius.ios.debug

// App Display Name
PRODUCT_NAME = Obius (Dev)
DISPLAY_NAME = Obius Dev

// Code Signing (automatic for development; DEVELOPMENT_TEAM comes from Secrets.xcconfig)
CODE_SIGN_STYLE = Automatic

// Logging
OBIUS_LOG_LEVEL = debug
OBIUS_ENABLE_ANALYTICS = NO
