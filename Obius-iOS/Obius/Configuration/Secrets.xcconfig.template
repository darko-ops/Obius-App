// Secrets Configuration Template
// Copy this file to Secrets.xcconfig and fill in your values
// DO NOT commit Secrets.xcconfig to version control

// Anthropic / Claude (only needed for direct Claude calls; AI normally proxies via Supabase)
CLAUDE_API_KEY = sk-ant-your-key-here

// RevenueCat — get from app.revenuecat.com → Project → API Keys
// The DEBUG key is the sandbox key (test_...), RELEASE is the production key (appl_...)
REVENUECAT_API_KEY_DEBUG = test_your_sandbox_key_here
REVENUECAT_API_KEY_RELEASE = appl_your_production_key_here

// Apple Developer Team ID for code signing
DEVELOPMENT_TEAM = your-team-id

// Optional: Provisioning Profile for release builds
PROVISIONING_PROFILE_SPECIFIER = your-profile-name
